# Referencia de valores. Copialos al entorno local del proceso; Spring no carga este archivo.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/plazoleta_bd
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=enter-locally-do-not-commit
DDL_AUTO=update
SQL_LOGGING=true

# AUTH_SECRET debe coincidir con Usuarios y tener al menos 16 caracteres.
AUTH_SECRET=replace-with-a-shared-secret-of-at-least-32-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-token-of-32-or-more-characters

# El servicio Usuarios necesita implementar el endpoint documentado en docs/contrato-usuarios.md.
USUARIOS_BASE_URL=http://localhost:8081
USUARIOS_OWNER_VALIDATION_PATH=/api/v1/usuarios/{id}/validacion-propietario
