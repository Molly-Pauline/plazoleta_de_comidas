# Copiar a .env y completar. El archivo .env NO se versiona.

# Firma del token de sesion (HU-05). Minimo 16 caracteres.
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Cuenta ADMINISTRADOR inicial. Si no se definen, el servidor genera una
# clave aleatoria y la imprime por consola al arrancar.
ADMIN_CORREO=admin@plazoleta.com
ADMIN_CLAVE=

# Supabase (HU-02)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
